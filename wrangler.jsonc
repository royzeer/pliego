{
  // Configuración para publicar Pliego en Cloudflare Workers.
  "name": "pliego",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-25",
  // Compila la página antes de publicarla (crea la carpeta dist).
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo las rutas /api/ pasan por el Worker; todo lo demás se sirve directo y gratis.
    "run_worker_first": ["/api/*"]
  },
  // IA gratuita de Cloudflare (10.000 neuronas al día) para resumir, traducir y preguntar.
  "ai": {
    "binding": "AI"
  },
  // Base de datos de cuentas y pagos de Pliego Pro (Cloudflare D1). Las tablas se crean solas.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pliego-db",
      "database_id": "997802e6-7898-4ff0-aace-4a79f35f6a36"
    }
  ]
}
