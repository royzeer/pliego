{
  // Configuración para publicar Pliego en Cloudflare Workers (archivos estáticos).
  "name": "pliego",
  "compatibility_date": "2026-11-25",
  // Compila la página antes de publicarla (crea la carpeta dist).
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
